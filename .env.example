# Solar Audit Production Environment Configuration
# Copy this file to .env and replace all placeholder values before starting.

# Central multi-site PostgreSQL mode (required for production_server.py)
CENTRAL_MODE=1
DATABASE_URL=postgresql+psycopg://solar_audit:CHANGE_ME@127.0.0.1:5432/solar_audit_prod

# Strong random secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX
MOBILE_API_ENABLED=1
MOBILE_API_SIGNING_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX

# HTTPS Cookie Security (set to 1 when served behind HTTPS reverse proxy)
SESSION_COOKIE_SECURE=1

# Waitress WSGI Server Tuning (100+ concurrent mobile/web users)
WAITRESS_HOST=0.0.0.0
WAITRESS_PORT=8080
WAITRESS_THREADS=24
WAITRESS_CONNECTION_LIMIT=500
WAITRESS_CHANNEL_TIMEOUT=180

# PostgreSQL Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800

# Login Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=15
LOGIN_RATE_LIMIT_WINDOW_SEC=300
